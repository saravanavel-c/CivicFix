# CivicFix Frontend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# Supabase project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/publishable key — safe to expose to the browser.
# Authorization is enforced by Row Level Security policies, NOT by keeping this key secret.
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Backend API base URL — leave empty in dev (Vite proxies /api to localhost:5000).
# In production, set this to your deployed backend origin.
# Example: https://civicfix-api.yourdomain.com
VITE_API_BASE_URL=
