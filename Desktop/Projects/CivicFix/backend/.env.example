# CivicFix Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# Express server port (default: 5000)
PORT=5000

# Supabase project URL (same as VITE_SUPABASE_URL in frontend)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase service_role key — server-side ONLY, bypasses RLS.
# NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Groq API key — used for LLM complaint validation (optional).
# Without this, validation falls back to rule-based checks only.
GROQ_API_KEY=your-groq-api-key

# Google Gemini API key — required for AI image classification.
# Without this, POST /api/classify-image will return a 503.
GEMINI_API_KEY=your-gemini-api-key

# Allowed frontend origin for CORS (comma-separated for multiple)
# Example: http://localhost:5173 or https://civicfix.yourdomain.com
FRONTEND_ORIGIN=http://localhost:5173
